# Standard
.DS_Store
*.log
*.swp
.idea/
.vscode/

# Node
node_modules/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Editor backups
*.bak
*.tmp
*.orig

# Local vendor configs (per-developer)
.claude/settings.local.json

# Secrets — never commit. Backstopped by the pre-push gitleaks gate
# (see markdowns/protocols/supervision.md "Pre-push secret gate").
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
*_rsa
*.rsa
credentials.json
service-account*.json
auth.json
.codex/auth.json
secrets.*
*.secret
*.secrets
.netrc

# Agent-stack card masters stay local; only the web JPGs (hero + 3x3 grid) are tracked.
assets/img/*.png

# Agent-stack tile PNGs stay local — generated from prompts, not tracked.
# See markdowns/meta-layer/agent-stack-prompts.md for the recipe.
markdowns/meta-layer/agent-stack-tiles/
markdowns/meta-layer/agent-stack-tiles-archive/
markdowns/meta-layer/_output/

# Quarto build artifacts
markdowns/meta-layer/.quarto/
markdowns/meta-layer/_freeze/
